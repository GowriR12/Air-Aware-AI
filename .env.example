# IBM watsonx.ai configuration for the AirAware AI Assistant.
# Copy these names into your project secrets — never commit real values.

# API key from IBM Cloud (IAM -> API keys)
IBM_WATSONX_API_KEY=

# watsonx.ai project ID (Project -> Manage -> General -> Project ID)
IBM_WATSONX_PROJECT_ID=

# Regional watsonx.ai endpoint, e.g. https://us-south.ml.cloud.ibm.com
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Granite model to use, e.g. ibm/granite-3-8b-instruct
IBM_GRANITE_MODEL_ID=ibm/granite-3-8b-instruct
